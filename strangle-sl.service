[Unit]
Description=Delta Exchange India Stop-Loss Monitor & Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/sl_strangle
Environment=NODE_ENV=production
EnvironmentFile=-/root/sl_strangle/.env
Environment=PATH=/root/.nvm/versions/node/v24.21.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Node executable path on your VPS
ExecStart=/root/.nvm/versions/node/v24.21.0/bin/node index.js

# Graceful stop
KillSignal=SIGINT
TimeoutStopSec=30
KillMode=mixed

# Auto-recovery
Restart=always
RestartSec=5s

# File descriptor limits
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strangle-sl

[Install]
WantedBy=multi-user.target
