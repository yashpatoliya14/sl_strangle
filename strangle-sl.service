[Unit]
Description=Delta Exchange India Stop-Loss Monitor & Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/strangle-sl
Environment=NODE_ENV=production
EnvironmentFile=-/root/strangle-sl/.env

# Node binary path
ExecStart=/usr/bin/node index.js

# Graceful stop
KillSignal=SIGINT
TimeoutStopSec=30
KillMode=mixed

# Auto-recovery
Restart=always
RestartSec=5s

# File descriptor limits
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strangle-sl

[Install]
WantedBy=multi-user.target
