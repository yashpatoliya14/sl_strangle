# ============================================================================
#  SMART STRANGLE SL ENGINE - DELTA EXCHANGE INDIA + TELEGRAM BOT
# ============================================================================

# --- 1. Delta Exchange India API Credentials ---
DELTA_API_KEY=your_delta_india_api_key_here
DELTA_API_SECRET=your_delta_india_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange

# --- 2. Dynamic SL & TP (Calculated from Up & Running Strangle) ---
# When true: Automatically fetches running strangle's max profit ($10)
# and dynamically sets Virtual Combined Stop-Loss to -$10 (1:1 Risk/Reward)
AUTO_CALCULATE_SL=true
SL_RATIO_OF_MAX_PROFIT=1.0
AUTO_CALCULATE_TP=true

# Fallback manual values if AUTO_CALCULATE_SL is false
COMBINED_SL_AMOUNT=10
COMBINED_TARGET_PROFIT=10

# --- 3. SL Alerting Sequence (5 Alerts, 10 Minutes Apart) ---
# Minutes between repeated alerts when Stop-Loss is breached
SL_ALERT_INTERVAL_MINUTES=10
# Maximum number of alerts to send (5 alerts = 0m, 10m, 20m, 30m, 40m)
SL_MAX_ALERTS=5
# Auto-close on SL:
# false = Alert-only mode (sends 5 alerts and allows 1-tap manual square-off via Telegram)
# true  = Instantly sends market exit orders to close both legs when SL is breached
AUTO_CLOSE_ON_SL=false

# --- 4. Telegram Bot Notifications & Interactive Buttons ---
# Includes 'sl_set' button to adjust Stop-Loss live from Telegram chat
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_ENABLED=false

# --- 5. Monitor & Execution Mode ---
POLL_INTERVAL_MS=1000

# true  = Simulation mode with mock prices and simulated fills
# false = Live execution with real Delta Exchange India orders
DRY_RUN=true

# Strangle Option Symbols (Optional - auto-detects short CE & PE if omitted)
CALL_SYMBOL=C-BTC-90000-280226
PUT_SYMBOL=P-BTC-80000-280226
